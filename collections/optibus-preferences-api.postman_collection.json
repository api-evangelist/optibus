          "name": "List holidays",
          "request": {
            "name": "List holidays",
            "description": {
              "content": "Returns the configured holidays (as in bank holidays).\nThis is distinct from individual driver absences.\nIf `startDate` and `endDate` are provided, the response will include only holidays within that date range.\nIf neither is provided, all configured holidays are returned.\n\n### Important Notes:\n- Both `startDate` and `endDate` must be provided together.\n- Dates are expected in the format `YYYY-MM-DD`.",
              "type": "text/plain"
            },
