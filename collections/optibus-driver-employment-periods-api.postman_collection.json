          "name": "List driver employment periods",
          "request": {
            "name": "List driver employment periods",
            "description": {
              "content": "List existing driver employment periods in the system, with optional filtering capability.\n\nNotes:\n- The result is paginated. Check the `pagination` property in the response to see the total number of pages and the current page number.\n- Information about the modelling of date periods for each entry:\n  - `startDate` is mandatory\n  - `endDate` is optional - if omitted, the employment period will be ongoing indefinitely",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v2",
                "drivers",
                "employment-periods"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "driverIds",
                  "value": "<string>",
                  "description": "- Comma-separated list of driver IDs to filter for"
                },
                {
                  "disabled": false,
                  "key": "driverIds",
                  "value": "<string>",
                  "description": "- Comma-separated list of driver IDs to filter for"
                },
                {
                  "disabled": false,
                  "key": "fromDate",
                  "value": "<date>",
                  "description": "- Date string formatted as `YYYY-MM-dd`. Only employment periods that end on or after this date are returned."
                },
                {
                  "disabled": false,
                  "key": "toDate",
                  "value": "<date>",
                  "description": "- Date string formatted as `YYYY-MM-dd`. Only employment periods that start on or before this date are returned."
                },
                {
                  "disabled": false,
                  "key": "page",
                  "value": "<integer>",
                  "description": "- 1-indexed integer indicating which page of results to pull"
