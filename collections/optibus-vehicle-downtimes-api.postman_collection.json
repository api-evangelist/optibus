      "name": "Vehicle Downtimes",
      "description": {
        "content": "API endpoints for managing downtimes for vehicles - i.e. periods where they are unavailable for service.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "5229a181-c21d-4c4e-b2f7-a6b2d5ee4a48",
          "name": "List vehicle downtimes",
          "request": {
            "name": "List vehicle downtimes",
            "description": {
              "content": "List existing vehicle downtimes in the system, with optional filtering capability.\n\nNotes:\n- The result is paginated. Check the `pagination` property in the response to see the total number of pages and the current page number.\n- Information about the modelling of date/time periods for each entry:\n  - `startDate` is mandatory\n  - `endDate` is optional - if omitted, the downtime will be ongoing indefinitely\n  - `startTime` and `endTime` are optional - if omitted, the downtime will be for the entire day(s) specified by `startDate` and `endDate`",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "vehicles",
                "downtimes"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "vehicleIds",
                  "value": "<string>",
                  "description": "- Comma-separated list of vehicle IDs to filter for"
                },
                {
                  "disabled": false,
                  "key": "fromDate",
                  "value": "<string>",
                  "description": "- Date string formatted as `YYYY-MM-dd`. Only downtimes that end on or after this date are returned."
                },
                {
                  "disabled": false,
                  "key": "toDate",
                  "value": "<string>",
                  "description": "- Date string formatted as `YYYY-MM-dd`. Only downtimes that start on or before this date are returned."
                },
                {
                  "disabled": false,
                  "key": "page",
                  "value": "<integer>",
                  "description": "- 1-indexed integer indicating which page of results to pull"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "Authorization"
                },
                {
                  "key": "value",
                  "value": "{{apiKey}}"
                },
                {
                  "key": "in",
                  "value": "header"
                }
              ]
            }
          },
