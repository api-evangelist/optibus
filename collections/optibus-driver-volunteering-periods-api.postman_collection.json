      "name": "Driver Volunteering Periods",
      "description": {
        "content": "API endpoints for fetching volunteering periods for drivers - i.e. periods where a driver is willing to volunteer for extra work, such as on a rest day or for overtime.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "a7a2550e-9cf2-44bd-80ac-407687a05e3d",
          "name": "List driver volunteering periods",
          "request": {
            "name": "List driver volunteering periods",
            "description": {
              "content": "List existing driver volunteering periods in the system, with optional filtering capability.\n\nNotes:\n- The result is paginated. Check the `pagination` property in the response to see the total number of pages and the current page number.\n- A volunteering period matches the date-range filter when it overlaps the `[fromDate, toDate]` window.\n- The time range (`startTime`, `endTime`, `timePeriodCode`) is either fully present or all `null` for a given period.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "drivers",
                "volunteering-periods"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "driverIds",
                  "value": "<string>",
                  "description": "- Comma-separated list of driver IDs to filter for"
                },
                {
                  "disabled": false,
                  "key": "driverIds",
                  "value": "<string>",
                  "description": "- Comma-separated list of driver IDs to filter for"
                },
                {
                  "disabled": false,
                  "key": "fromDate",
                  "value": "<date>",
                  "description": "- Date string formatted as `YYYY-MM-dd`. Only volunteering periods that end on or after this date are returned."
                },
                {
                  "disabled": false,
                  "key": "toDate",
                  "value": "<date>",
                  "description": "- Date string formatted as `YYYY-MM-dd`. Only volunteering periods that start on or before this date are returned."
                },
                {
                  "disabled": false,
                  "key": "page",
                  "value": "<integer>",
                  "description": "- 1-indexed integer indicating which page of results to pull"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "Authorization"
                },
                {
                  "key": "value",
                  "value": "{{apiKey}}"
                },
                {
                  "key": "in",
                  "value": "header"
                }
              ]
            }
          },
