        {
          "id": "8e12fe92-a6c3-4d5d-b73f-7a0fffd96890",
          "name": "Fetch signing deviations",
          "request": {
            "name": "Fetch signing deviations",
            "description": {
              "content": "Calculate the signing deviations for the drivers in the given date range and region. 'Signing deviations' refer to the difference between\nthe actual and expected sign-on and sign-off times for a driver. The expected times are calculated based on the driver's assigned work.\n\nDeviation might be classified either early or late, calculated according to a defined threshold.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "drivers",
                "signing-deviations"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "from",
                  "value": "<date>",
                  "description": "(Required) The start of the date range to get the signing deviations from"
                },
                {
                  "disabled": false,
                  "key": "to",
                  "value": "<date>",
                  "description": "(Required) The end of the date range to get the signing deviations from"
                },
                {
                  "disabled": false,
                  "key": "regionUuid",
                  "value": "<string>",
                  "description": "(Required) The region to get the signing deviations from"
                },
                {
                  "disabled": false,
                  "key": "driverIds",
                  "value": "<string>",
                  "description": "The driver IDs for which to get the signing deviations. if empty all drivers will be returned"
                },
                {
                  "disabled": false,
                  "key": "driverIds",
                  "value": "<string>",
                  "description": "The driver IDs for which to get the signing deviations. if empty all drivers will be returned"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "Authorization"
                },
                {
                  "key": "value",
                  "value": "{{apiKey}}"
                },
                {
                  "key": "in",
                  "value": "header"
                }
              ]
            }
          },
