                  "value": "<string>",
                  "description": "- Optional. The ID of a specific depot for which workEntities are to be retrieved."
                },
                {
                  "disabled": false,
                  "key": "driverIds",
                  "value": "<string>",
                  "description": "- Optional. An array of driver IDs for whom workEntities are to be retrieved."
                },
