        {
          "id": "d29be0f8-8b26-434d-b1d7-5512621d3713",
          "name": "Fetch per-task statistics for a date range",
          "request": {
            "name": "Fetch per-task statistics for a date range",
            "description": {
              "content": "Retrieves per-task statistics for a date range, mirroring the duty side panel in the Ops UI.\nOne response row per `(date, task)` pair, including the statistics configured under the customer's `dutyFilter` preference.\n\nTo avoid timeouts the calculation is capped. Call `GET /v2/duty-stats-calculation-limit` first with\nthe same dates and depots to size your requests. This endpoint returns 413 when:\n- the requested range spans more than `daysLimit` days, or\n- `daysLimit` is `0` (a day too dense to fetch whole) and the request is not a single day\n  (`fromDate` equal to `toDate`) with a `taskIds` filter of at most `tasksLimit` tasks.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v2",
                "duty-stats"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "fromDate",
                  "value": "<date>",
                  "description": "(Required) - Start of the date range (inclusive), YYYY-MM-DD."
                },
                {
                  "disabled": false,
                  "key": "toDate",
                  "value": "<date>",
                  "description": "(Required) - End of the date range (inclusive), YYYY-MM-DD. Must be `>= fromDate`."
                },
                {
                  "disabled": false,
                  "key": "depotIds",
                  "value": "<string>",
                  "description": "- Optional. Restrict to specific depots; all customer depots if omitted."
                },
                {
                  "disabled": false,
                  "key": "depotIds",
                  "value": "<string>",
                  "description": "- Optional. Restrict to specific depots; all customer depots if omitted."
                },
                {
                  "disabled": false,
                  "key": "driverIds",
                  "value": "<string>",
                  "description": "- Optional. Restrict to duties assigned to these drivers."
                },
                {
                  "disabled": false,
                  "key": "driverIds",
                  "value": "<string>",
                  "description": "- Optional. Restrict to duties assigned to these drivers."
                },
                {
                  "disabled": false,
                  "key": "includeUnassigned",
                  "value": "<boolean>",
                  "description": "- Optional. Defaults to `false` when `driverIds` is provided, `true` when omitted."
                },
                {
                  "disabled": false,
                  "key": "taskIds",
                  "value": "<string>",
                  "description": "- Optional. Filter by internal task UUIDs (not display IDs). Required when `daysLimit` is `0` — see above."
                },
                {
                  "disabled": false,
                  "key": "taskIds",
                  "value": "<string>",
                  "description": "- Optional. Filter by internal task UUIDs (not display IDs). Required when `daysLimit` is `0` — see above."
                },
                {
                  "disabled": false,
                  "key": "statIds",
                  "value": "<string>",
                  "description": "- Optional. Restrict which statistics to compute. `\"*\"` is not allowed."
                },
                {
                  "disabled": false,
                  "key": "statIds",
                  "value": "<string>",
                  "description": "- Optional. Restrict which statistics to compute. `\"*\"` is not allowed."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "Authorization"
                },
                {
                  "key": "value",
                  "value": "{{apiKey}}"
                },
                {
                  "key": "in",
                  "value": "header"
                }
              ]
            }
          },
